{
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": true,
    "module": "CommonJS",
    // 必须 ≤ ES2017：微信开发者工具「自动预览/上传」的 JS 解析器不支持 ES2020 语法
    // （?. 可选链 / ?? 空值合并，报 Unexpected token: punc (.)）。
    // tsc 会按此 target 将 ?. / ?? 降级为三元表达式；async/await（ES2017）保留原生。
    // lib 保持 ES2020 仅影响类型检查，不影响产物语法。
    "target": "ES2017",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    // 既有债（从未跑过 tsc 的微信端）：事件回调参数隐式 any 共 44 处。
    // 逐个补类型留给在线化（M5）类型卫生阶段；当前豁免以免门禁长期红。
    "noImplicitAny": false,
    // mobx observable/action 模式在对象字面量 action 内使用 `this`（既有代码风格），
    // tsc 无法从 observable() 推断 action 函数 this 类型；不豁免则全仓报错。
    "noImplicitThis": false,
    "skipLibCheck": true,
    "strictPropertyInitialization": true,
    "lib": ["ES2020"],
    "typeRoots": [
      "./typings"
    ],
    "baseUrl": ".",
    "paths": {
      "@vant/weapp/*": ["miniprogram/node_modules/@vant/weapp/dist/*"]
    }
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
