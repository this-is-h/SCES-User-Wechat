.root {
  width: 750rpx;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background-color: var(--van-doc-background);
  color: var(--van-doc-text-color-1);
}

.root scroll-view {
  box-sizing: border-box;
  height: calc(100vh - 46px - 50px - var(--status-bar-height));
}

.root scroll-view .scroll-root {
  box-sizing: border-box;
  padding: 20px 0;
}

/* Vant Cascader 1.11 hard-codes the tab colors, so keep its selected path
 * readable when the surrounding theme switches to dark mode. */
.van-cascader__title {
  color: var(--van-doc-text-color-1) !important;
}

.van-tabs__scroll {
  background-color: var(--tabs-nav-background-color) !important;
}

.van-cascader__tab {
  color: var(--tab-text-color) !important;
}

.van-cascader__tab--unselected {
  color: var(--tab-disabled-text-color) !important;
}
