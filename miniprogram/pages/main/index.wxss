/* pages/main/main.wxss */
.status-card {
  margin: 0 20px;
  padding: 16px 16px;
  background: var(--van-doc-background-2);
  border-radius: 16rpx;
  border: 1px solid var(--van-doc-border-color);
}

.status-card-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 8px;
}

.status-card-body {
  font-size: 14px;
  color: var(--van-doc-text-color-2);
}

.ranking-entry {
  margin-top: 12px;
  color: var(--van-doc-blue);
  font-size: 14px;
}

.scroll-root {
  display: flex;
  flex-direction: column;
  gap: 2em;
}

.h1 {
  color: var(--van-doc-text-color-2);
  font-size: 18px;
  font-weight: bold;
  padding: 0 20px 0.5em;
}

.h2 {
  color: var(--van-doc-text-color-4);
  font-size: 14px;
  font-weight: 400;
  padding: 0 20px 0.7em;
}

.score-group {
  display: flex;
  flex-direction: column;
  gap: 1em;
}

.stepper-index--van-stepper--round .stepper-index--van-stepper__minus {
  border: 1px solid var(--van-doc-blue)!important;
  color: var(--van-doc-blue)!important;
}

.stepper-index--van-stepper--round .stepper-index--van-stepper__plus {
  background-color: var(--van-doc-blue)!important;
}

.score-group .van-radio-group {
  display: flex!important;
  flex-direction: column!important;
  gap: 5px!important;
}

.function-button {
  padding: 0 1em;
}

.floating-export-button {
  position: fixed;
  right: 16px;
  bottom: calc(60px + env(safe-area-inset-bottom));
  z-index: 1000;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.25s ease, transform 0.25s ease;
  pointer-events: none;
}

.floating-export-button--visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.floating-export-button .van-button {
  box-shadow: 0 8px 18px rgba(25, 137, 250, 0.25);
}

.export-dialog-title {
  font-weight: bold;
  color: var(--van-doc-text-color-1);
}

.export-dialog-notice {
  width: 100%;
}

.export-dialog-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 1em 0;
  color: var(--van-doc-text-color-2);
}

.export-dialog-content-strong {
  margin-top: 0.5em;
  color: var(--van-doc-danger-color);
  font-weight: bold;
}

.export-dialog-content-warning {
  margin-top: 0.5em;
  color: var(--van-doc-danger-color);
  font-weight: bold;
}

.export-dialog-content-end {
  margin-top: 0.5em;
}
