/* pages/main/score.wxss */
.root {
  height: 100vh;
  min-height: 0;
  overflow: hidden;
}

.root scroll-view {
  flex: 1;
  min-height: 0;
  height: auto;
  /* background: #ffffff; */
}

.take-highest-warning {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  background: var(--van-doc-warning-background);
  border-bottom: 1rpx solid var(--van-doc-warning-border);
  color: var(--van-doc-warning-text);
}

.take-highest-warning-icon {
  flex-shrink: 0;
  margin-top: 2rpx;
  font-size: 34rpx;
}

.take-highest-warning-content {
  flex: 1;
  min-width: 0;
}

.take-highest-warning-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.take-highest-warning-text {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.root scroll-view .scroll-root {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.content-card {
  background: var(--van-doc-background-2);
  border: 1rpx solid var(--van-doc-border-color);
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.base-info view {
  font-size: 28rpx;
  color: var(--van-doc-text-color-2);
  line-height: 1.8;
}

.paragraph {
  margin-top: 20rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--van-doc-text-color-2);
  text-indent: 2em;
}

.score-table {
  margin-top: 28rpx;
  border: 1rpx solid var(--van-doc-border-color);
  border-radius: 12rpx;
  overflow: hidden;
}

.score-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--van-doc-border-color);
  min-height: 72rpx;
}

.score-row:last-child {
  border-bottom: none;
}

.score-row-header {
  background: var(--van-doc-code-background);
}

.score-col {
  padding: 14rpx 12rpx;
  box-sizing: border-box;
  color: var(--van-doc-text-color-2);
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.score-col-no {
  width: 22%;
}

.score-col-desc {
  width: 56%;
}

.score-col-desc-content {
  text-align: justify;
  text-align-last: left;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
  word-break: break-all;
}

.score-col-score {
  width: 22%;
  color: var(--van-doc-blue);
  font-weight: 700;
}

.empty-tip {
  padding: 18rpx 16rpx;
  color: var(--van-doc-text-color-4);
  font-size: 26rpx;
}

.score-row-total {
  background: var(--van-doc-blockquote-background);
}

.score-row-total .score-col {
  font-weight: 700;
}

.score-col-score-total {
  color: var(--van-doc-blue);
  font-size: 34rpx;
  font-weight: 800;
}

.sign-area {
  margin: 80rpx 0;
}

.sign-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.signed-wrapper {
  margin-top: 12rpx;
}

.signed-image {
  width: 100%;
  border: 1rpx solid var(--van-doc-border-color);
  border-radius: 8rpx;
}

.signed-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sign-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.sign-btn.main {
  background: var(--van-doc-blue);
  /* color: var(--van-doc-white); */
}

.sign-btn.plain {
  /* color: var(--van-doc-text-color-2); */
}

.closing {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.closing-line {
  color: var(--van-doc-text-color-2);
  font-size: 28rpx;
  line-height: 1.9;
  display: flex;
  align-items: center;
}

.closing-sign-image {
  width: 180rpx;
  height: 64rpx;
  margin-left: 8rpx;
}

.closing-sign-placeholder {
  margin-left: 8rpx;
  color: var(--van-doc-text-color-4);
}

.snapshot-preview {
  margin-top: 24rpx;
  background: var(--van-doc-background-2);
  border-radius: 16rpx;
  padding: 20rpx;
}

.snapshot-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.snapshot-image {
  width: 100%;
}

.preview-image {
  width: 100%;
  height: 40vh;
  border: 1rpx solid var(--van-doc-border-color);
  border-radius: 8rpx;
}

.preview-tip {
  margin-top: 12rpx;
  color: var(--van-doc-text-color-4);
  font-size: 24rpx;
  text-align: center;
}
