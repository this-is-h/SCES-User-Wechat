<!--pages/hetongsignature/index.wxml-->
<scroll-view scroll-y="true">
  <canvas canvas-id='secondCanvas' style='width:100%;height:{{750}}px;'></canvas>
</scroll-view>
<signaturehetong bindconfirm="confirmTap" bindcancel="cancelTap" wx:if="{{imgfile==''}}"></signaturehetong>
<view wx:if="{{imgfile!=''}}" class="subbtn">
  <button type="default" class='txt' style="color:#333" bindtap="retDraw">重新签名</button>
  <button type="primaryblue" class='txt' bindtap="OkDraw">提交签字</button>
</view>
<view style="padding-bottom:100rpx;"></view>
<view style="clear:both;width:100%;height:70vh;text-align: center;">
  <image wx:if="{{allimgfile!=''}}" src="{{allimgfile}}" mode="scaleToFill" style="width:100%;height:720px;border: 1px solid #ccc;margin-top: 10rpx;"></image>
</view>